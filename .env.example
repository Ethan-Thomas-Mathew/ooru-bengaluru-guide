# Copy this file to .env and change the values.
# Port for the API server (npm run dev) or the whole site (npm start)
PORT=3001
# Password for the /admin page, at least 16 characters. Leave empty to
# auto-generate a strong one (saved in server/data/admin-token.txt and
# printed when the server starts).
ADMIN_TOKEN=
# Set to 1 only when the server runs behind a host's proxy (Render, Railway,
# Fly). Leave at 0 on your laptop, or people can fake their IP to skip limits.
TRUST_PROXY=0
